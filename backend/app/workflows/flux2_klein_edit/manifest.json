{
  "name": "flux2_klein_edit",
  "family": "flux.2-klein-base-4b",
  "description": "FLUX.2 [klein] base 4B reference edit: each reference is VAE-encoded and chained through ReferenceLatent on both prompts (Comfy-Org 'Image Edit (Flux.2 Klein 4B)'), 20 steps cfg 5. 1-3 references.",
  "inputs": {
    "prompt":   {"type": "str", "required": true, "targets": [["Positive", "text"]]},
    "negative": {"type": "str", "default": "", "targets": [["Negative", "text"]]},
    "images":   {"type": "image_list", "required": true, "min": 1,
                 "slots": [["Ref1", "image"], ["Ref2", "image"], ["Ref3", "image"]],
                 "drop_unused": [["Ref2", "Ref2Scale", "Ref2Latent", "PosRef2", "NegRef2"],
                                 ["Ref3", "Ref3Scale", "Ref3Latent", "PosRef3", "NegRef3"]],
                 "bypass_unused": {"PosRef2": {"0": "conditioning"}, "NegRef2": {"0": "conditioning"},
                                   "PosRef3": {"0": "conditioning"}, "NegRef3": {"0": "conditioning"}}},
    "width":    {"type": "int", "default": 1024, "multiple_of": 16, "targets": [["Latent", "width"], ["Scheduler", "width"]]},
    "height":   {"type": "int", "default": 1024, "multiple_of": 16, "targets": [["Latent", "height"], ["Scheduler", "height"]]},
    "seed":     {"type": "int", "default": 0, "targets": [["Noise", "noise_seed"]]},
    "steps":    {"type": "int", "default": 20, "targets": [["Scheduler", "steps"]]},
    "filename_prefix": {"type": "str", "default": "mixai/flux2edit", "targets": [["Save", "filename_prefix"]]}
  },
  "outputs": {"image": {"node": "Save", "kind": "image"}},
  "models": {
    "diffusion_models": ["flux-2-klein-base-4b.safetensors"],
    "text_encoders": ["qwen_3_4b.safetensors"],
    "vae": ["flux2-vae.safetensors"]
  },
  "lora": {"after": "UNet"},
  "progress_weights": {"Sampler": 10, "UNet": 2, "TextEncoder": 2}
}
