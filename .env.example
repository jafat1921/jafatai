# Mix AI Cinema Studio — copy to .env and edit. Same keys on Windows and Linux.

APP_ENV=dev                      # dev | prod
APP_SECRET=change-me-to-a-long-random-string
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Seeded on first start: the first account, and the studio's admin
ADMIN_EMAIL=admin@mixai.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
# Pre-fill the login form with the admin credentials. Only works when APP_ENV=dev
# and the browser is on this machine; never offered through a proxy or in prod.
DEV_LOGIN_PREFILL=true

# Accounts (contract v38)
# open: anyone can sign up and gets their own private studio; invite: only accounts the admin makes
# (Admin -> Users, or `python -m app.manage create-user`); closed: no new accounts at all
SIGNUP=open
# new accounts confirm their email before they can start any work; off: they can start straight away
EMAIL_VERIFY=on
# the address people open the studio at. Email links point here, and it's an origin the CSRF check accepts.
# Empty: the first CORS_ORIGINS entry
PUBLIC_URL=

# Email (contract v38). console: the message and its link go to the API log (dev, or before SMTP is set up);
# smtp: sent through the server below, e.g. Brevo, Mailgun or Amazon SES
EMAIL_BACKEND=console
# SMTP_HOST=smtp-relay.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Mix AI Cinema Studio <studio@example.com>
# starttls (port 587) | ssl (port 465) | off
# SMTP_TLS=starttls

# Token API (contract v27). off: only the admin account sees Settings -> API tokens and the docs;
# on: owners and editors can make tokens and the docs open to anyone signed in.
PUBLIC_API=off
# Swagger at /api/docs, ReDoc at /api/redoc and the spec at /api/openapi.json (gated as above)
API_DOCS=on

# Storage. Relative paths resolve against the repo root.
DATABASE_URL=sqlite:///./data/mixai.db
DATA_DIR=./data

# Generation backend: "mock" (no GPU needed) or "comfy"
GEN_DRIVER=mock

# ComfyUI on the GPU box (comma-separated for multiple GPU instances)
COMFY_URLS=http://127.0.0.1:8188
# Two GPUs: one ComfyUI per job lane, so images and video render at the same time.
# Image work (portraits, frames, image edits/upscales) goes to COMFY_IMAGE_URLS, takes, long takes
# and video upscales to COMFY_VIDEO_URLS. Empty = use COMFY_URLS. Run one worker per lane
# (python -m app.worker --lanes image / video / general; see INSTALL.md).
COMFY_IMAGE_URLS=
COMFY_VIDEO_URLS=
COMFY_AUTH_TOKEN=
COMFY_VERIFY_TLS=false
COMFY_LORA_DIR=

# Ollama (OpenAI-compatible endpoint at <host>/v1)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_REASONING=deepseek-r1:14b
LLM_MODEL_CREATIVE=gemma4:e4b
LLM_MODEL_VISION=gemma4:e4b

# Ad Studio's copywriter (contract v36 addendum). Empty: the largest of ADS_LLM_MODELS that Ollama has
# installed (the creative model when none is). Copy quality tracks model size closely, so the 26B wins
ADS_LLM_MODEL=
ADS_LLM_MODELS=gemma4:26b,qwen2.5:14b-instruct,gemma4:e4b

# How the model's thinking is separated from its answer: deepseek (<think> tags / Ollama "think" field) | none
LLM_REASONING_FORMAT=deepseek

# Optional: ComfyUI's output folder when the app runs on the same machine (faster than /view downloads)
COMFY_OUTPUT_DIR=

# Leave empty to use ffmpeg on PATH (server), falling back to the bundled imageio-ffmpeg (Windows dev)
FFMPEG_BIN=

# Long takes (contract v2). Takes longer than one LTX pass (~10.7 s) are rendered as chunks
# and joined into one video. LONGTAKE_MAX_S caps a single take.
LONGTAKE_MAX_S=300
# Target length of each chunk in seconds (rounded so frames are 8n+1)
CHUNK_S=8
# Upper limit for the crossfade at each join, in seconds. The real fade is also capped by the
# frames two chunks share (the context window below) and by a third of the shorter chunk.
CHUNK_OVERLAP_S=1
# Tail frames of the previous chunk that condition the next one (snapped to 8n+1; 9 = 2 latent frames)
CHUNK_CONTEXT_FRAMES=9
# extend = continue from the tail frames + audio (ltx23_extend); i2v = restart from the last frame (fallback)
LONGTAKE_METHOD=extend

# Quick Create autopilot (contract v4). The vision model (LLM_MODEL_VISION) scores every
# generated image 0-10 against its description; below the threshold it re-rolls up to
# AUTO_RETRIES times and keeps the best. If the vision model can't be reached, the newest
# image is approved and marked "unchecked".
AUTO_APPROVE_SCORE=6
AUTO_RETRIES=2
VISION_TIMEOUT_S=180

# Upscaling stitched videos (contract v4). The film is cut into overlapping segments, each one is
# upscaled in ComfyUI and checkpointed (a restart resumes), then they're joined with a crossfade in
# the overlaps and the original audio is copied back untouched.
UPSCALE_SEGMENT_S=4
UPSCALE_OVERLAP_S=0.5
# best = SeedVR2 (temporally consistent), fast = FlashVSR, quick = RealESRGAN frame by frame
UPSCALE_DEFAULT_ENGINE=best
# SeedVR2 size for engine "best" when the request doesn't say: 3b or 7b (7B is roughly 2x slower)
UPSCALE_SEEDVR2_MODEL=3b
# Image upscaling: Redraw (Z-Image) and Faithful (SeedVR2) outputs are held under this many megapixels
# (and 4096 px on the long side) to stay inside VRAM; 8.4 lets a 16:9 4K frame through.
IMAGE_UPSCALE_MAX_MP=8.4
# Photo Studio "Heavy restore" uses SUPIR, whose weights are NON-COMMERCIAL ONLY. true while testing; set false
# for commercial work (Heavy restore is then hidden and refused) unless you have the authors' permission.
PHOTO_ALLOW_NONCOMMERCIAL=true
# Image tools whose weights are non-commercial or unverified: CatVTON virtual try-on (CC BY-NC-SA 4.0) and the
# lllyasviel/Annotators line art, anime line art and soft edge models (licence "other", not yet confirmed).
# true while testing. false hides them and refuses them (422); "Photo to line art" then runs on Qwen-Image-Edit,
# the try-on card disappears (Outfit swap stays) and Depth / Edge maps keep working (Apache-2.0 / no weights).
IMAGE_ALLOW_NONCOMMERCIAL=true
# Audio models whose licence limits commercial use: MiniMax-Music3 (community licence, commercial use only under
# US$20M revenue) and the OmniVoice speech engine (code Apache-2.0, but the weights are CC-BY-NC). true while
# testing. Set false for commercial work: both are hidden and refused (422), "auto" speech uses VoxCPM2, and
# gallery voices built on OmniVoice disappear. The story API (/api/stories) refuses OmniVoice either way.
AUDIO_ALLOW_NONCOMMERCIAL=true
# aerab / tashkeel for Arabic-script languages (uses the local LLM): every AI writer is told to mark its
# Urdu, Arabic, Persian... text, a verified second pass adds what it missed, and lyrics, scripts and quoted
# video dialogue are marked again before they render. false turns all of it off.
URDU_AERAB=true
# which languages get it: ur Urdu, ar Arabic, fa Persian, ps Pashto, sd Sindhi, pnb Punjabi (Shahmukhi)
AERAB_LANGUAGES=ur,ar,fa,ps,sd,pnb
# the Ollama model that adds the marks (e.g. gemma4:26b). Empty: LLM_MODEL_CREATIVE
AERAB_LLM_MODEL=
# Voice studio: each speech engine (OmniVoice, VoxCPM2, Chatterbox, Kokoro, faster-whisper) has its own venv
# under this folder; the worker runs backend/runners/<engine>.py with <dir>/<venv>/bin/python
AUDIO_VENVS_DIR=/data/venvs
# the Hugging Face cache the engine models were downloaded into (install-voice-models.sh prints it)
AUDIO_HF_HOME=
# CUDA device index each GPU worker hands to the speech runners (image lane worker, video lane worker)
AUDIO_GPU_IMAGE=0
AUDIO_GPU_VIDEO=1
# a runner that is still going after this many seconds is killed and the job fails
AUDIO_RUNNER_TIMEOUT_S=900
# audio-separator (audio-utils venv): the vocal model Dub and two-stem splits use, the Demucs model for
# four stems (vocals, drums, bass, other), and the folder both download into on first use
DUB_SEPARATION_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt
STEMS_FOUR_MODEL=htdemucs_ft.yaml
DUB_SEPARATION_MODEL_DIR=/data/models/audio-separator

# Burned subtitles (contract v24a): the Noto fonts (Nastaliq for Urdu, Naskh for Arabic and Persian...);
# install-server.sh puts them here. Renderer: auto (libass, Pillow when that can't shape) | ass | pillow
SUBTITLE_FONTS_DIR=/usr/share/fonts/truetype/noto
SUBTITLE_RENDERER=auto

# ---------------------------------------------------------------------------
# GPU SERVER PROFILE (Linux)
# The app runs next to ComfyUI and Ollama, so it uses loopback and bypasses Caddy.
# ---------------------------------------------------------------------------
# APP_ENV=prod
# APP_HOST=127.0.0.1                      # put Caddy in front, like the other apps
# DATA_DIR=/data/outputs/mixai
# DATABASE_URL=sqlite:////data/outputs/mixai/mixai.db
# GEN_DRIVER=comfy
# COMFY_URLS=http://127.0.0.1:8188,http://127.0.0.1:8189
# Images on GPU 0 (comfyui.service, 8188), video on GPU 1 (comfyui-gpu1.service, 8189).
# To swap which GPU does what, swap these two values and restart the mixai-worker@* services.
# COMFY_IMAGE_URLS=http://127.0.0.1:8188
# COMFY_VIDEO_URLS=http://127.0.0.1:8189
# COMFY_AUTH_TOKEN=
# COMFY_VERIFY_TLS=true
# COMFY_OUTPUT_DIR=/data/apps/ComfyUI/output
# COMFY_LORA_DIR=/data/apps/ComfyUI/models/loras
# LLM_BASE_URL=http://127.0.0.1:11434/v1
#
# WINDOWS DEV against the server: Ollama isn't exposed publicly, so tunnel it:
#   ssh -L 11434:127.0.0.1:11434 -L 8188:127.0.0.1:8188 gpu@SERVER_IP
# then use COMFY_URLS=http://127.0.0.1:8188 and LLM_BASE_URL=http://127.0.0.1:11434/v1
