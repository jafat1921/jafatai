{
  "1": {"class_type": "LoadImage", "_meta": {"title": "Source"}, "inputs": {"image": "example.png"}},
  "2": {"class_type": "ImageScale", "_meta": {"title": "Resize"},
        "inputs": {"image": ["1", 0], "upscale_method": "lanczos", "width": 1536, "height": 2048, "crop": "disabled"}},
  "3": {"class_type": "SeedVR2Preprocess", "_meta": {"title": "Pre"}, "inputs": {"resized_images": ["2", 0]}},
  "4": {"class_type": "VAELoader", "_meta": {"title": "VAE"}, "inputs": {"vae_name": "seedvr2_ema_vae_fp16.safetensors"}},
  "5": {"class_type": "UNETLoader", "_meta": {"title": "Model"},
        "inputs": {"unet_name": "seedvr2_3b_int8_convrot.safetensors", "weight_dtype": "default"}},
  "6": {"class_type": "VAEEncodeTiled", "_meta": {"title": "Encode"},
        "inputs": {"pixels": ["3", 0], "vae": ["4", 0], "tile_size": 512, "overlap": 128,
                   "temporal_size": 64, "temporal_overlap": 8}},
  "7": {"class_type": "SeedVR2Conditioning", "_meta": {"title": "Cond"},
        "inputs": {"model": ["5", 0], "vae_conditioning": ["6", 0]}},
  "8": {"class_type": "KSampler", "_meta": {"title": "Sampler"},
        "inputs": {"model": ["5", 0], "positive": ["7", 0], "negative": ["7", 1], "latent_image": ["6", 0],
                   "seed": 0, "steps": 1, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "9": {"class_type": "VAEDecodeTiled", "_meta": {"title": "Decode"},
        "inputs": {"samples": ["8", 0], "vae": ["4", 0], "tile_size": 512, "overlap": 128,
                   "temporal_size": 64, "temporal_overlap": 8}},
  "10": {"class_type": "SeedVR2PostProcessing", "_meta": {"title": "Post"},
         "inputs": {"images": ["9", 0], "original_resized_images": ["2", 0], "color_correction_method": "lab"}},
  "11": {"class_type": "SaveImage", "_meta": {"title": "Save"},
         "inputs": {"images": ["10", 0], "filename_prefix": "mixai/upscale"}}
}
