{
  "name": "ltx23_ia2v_extend",
  "family": "ltx-2.3",
  "description": "LTX-2.3 lip-synced continuation piece for the AI video podcast's continuous camera tracks: ltx23_extend's context frames (the previous piece's tail laid in place over the first latent frames) plus ltx23_ia2v's frozen speech, here the host's track audio for the whole window (context + new frames), encoded with the audio VAE and kept by a 0 SolidMask on SetLatentNoiseMask. The camera's angle keyframe guides the last frame at low strength (LTXVAddGuide) so the face doesn't drift over a long take; LTXVCropGuides takes the guide frame off again. dev fp8 + distilled LoRA as ltx23_ia2v; single_stage drops the upscaler and the second pass (the 480p draft). The context video's own audio isn't used. The first pass runs LTXVModalityGuidance (an extra pass per step with the audio/video cross-attention cut, pushed back toward the coupled prediction), Lightricks' lip-sync guidance at its reference scale 3; no_modality drops it.",
  "inputs": {
    "prompt":        {"type": "str", "required": true, "targets": [["Positive", "text"]]},
    "negative":      {"type": "str", "default": "pc game, console game, video game, cartoon, childish, ugly, blurry, low quality, still frame, frozen, watermark, subtitles, scene cut, jump cut",
                      "targets": [["Negative", "text"]]},
    "context_video": {"type": "image", "required": true, "targets": [["ContextVideo", "video"]]},
    "guide_image":   {"type": "image", "required": false, "targets": [["GuideImage", "image"]],
                      "if_missing": {"drop": ["GuideImage", "GuideScale", "GuidePre"],
                                     "bypass": {"KeyGuide": {"0": "positive", "1": "negative", "2": "latent"}}}},
    "speech_audio":  {"type": "image", "required": true, "targets": [["SpeechAudio", "audio"]]},
    "audio_start_s": {"type": "float", "default": 0.0, "targets": [["AudioTrim", "start_index"]]},
    "duration_s":    {"type": "float", "default": 10.0, "targets": [["AudioTrim", "duration"]]},
    "context_strength": {"type": "float", "default": 1.0,
                         "targets": [["ContextFrames", "strength"], ["ContextFrames2", "strength"]]},
    "guide_strength":   {"type": "float", "default": 0.2, "targets": [["KeyGuide", "strength"]]},
    "width":         {"type": "int", "default": 1280, "multiple_of": 32,
                      "targets": [["ContextScale2", "width"], ["AudioMask", "width"]]},
    "height":        {"type": "int", "default": 704, "multiple_of": 32,
                      "targets": [["ContextScale2", "height"], ["AudioMask", "height"]]},
    "latent_width":  {"type": "int", "default": 640, "multiple_of": 32,
                      "targets": [["VideoLatent", "width"], ["ContextScale", "width"], ["GuideScale", "width"]]},
    "latent_height": {"type": "int", "default": 352, "multiple_of": 32,
                      "targets": [["VideoLatent", "height"], ["ContextScale", "height"], ["GuideScale", "height"]]},
    "num_frames":    {"type": "int", "default": 241, "frames_8n1": true, "targets": [["VideoLatent", "length"]]},
    "fps":           {"type": "float", "default": 24.0,
                      "targets": [["Conditioning", "frame_rate"], ["Save", "frame_rate"]]},
    "seed":          {"type": "int", "default": 0, "targets": [["Noise", "noise_seed"], ["Noise2", "noise_seed"]]},
    "modality_scale": {"type": "float", "default": 3.0, "targets": [["ModalityGuide", "modality_scale"]]},
    "no_modality":   {"type": "bool", "default": false,
                      "if_set": {"drop": ["ModalityGuide"], "bypass": {"ModalityGuide": {"0": "model"}}}},
    "single_stage":  {"type": "bool", "default": false,
                      "if_set": {"drop": ["SpatialLoader", "ContextScale2", "Noise2", "Sigmas2", "Guider2"],
                                 "bypass": {"Separate2": {"0": "av_latent"}, "Sampler2": {"0": "latent_image"},
                                            "AVLatent2": {"0": "video_latent"}, "ContextFrames2": {"0": "latent"},
                                            "Upsample": {"0": "samples"}}}},
    "filename_prefix": {"type": "str", "default": "mixai/ltx_ia2v_ext", "targets": [["Save", "filename_prefix"]]}
  },
  "features": {"two_stage": ["SpatialLoader", "ContextScale2", "Upsample", "ContextFrames2", "AVLatent2", "Noise2",
                             "Sigmas2", "Guider2", "Sampler2", "Separate2"]},
  "outputs": {"video": {"node": "Save", "kind": "video"}},
  "models": {
    "checkpoints": ["ltx-2.3-22b-dev-fp8.safetensors"],
    "text_encoders": ["gemma_3_12B_it_fp4_mixed.safetensors"],
    "loras": ["ltx_2.3_22b_distilled_1.1_lora_dynamic_fro09_avg_rank_111_bf16.safetensors"],
    "latent_upscale_models": ["ltx-2.3-spatial-upscaler-x2-1.1.safetensors"]
  },
  "lora": {"after": "DistillLoRA", "output": 0},
  "progress_weights": {"Sampler": 8, "Sampler2": 8, "Checkpoint": 4, "TextEncoder": 3, "Upsample": 1, "Decode": 4, "Save": 1}
}
