{
  "1": {"class_type": "LoadImage", "_meta": {"title": "Source"}, "inputs": {"image": "example.png"}},
  "2": {"class_type": "UpscaleModelLoader", "_meta": {"title": "UpscaleModel"},
        "inputs": {"model_name": "RealESRGAN_x4plus.safetensors"}},
  "3": {"class_type": "ImageUpscaleWithModel", "_meta": {"title": "Enlarge"},
        "inputs": {"upscale_model": ["2", 0], "image": ["1", 0]}},
  "4": {"class_type": "ImageScale", "_meta": {"title": "Resize"},
        "inputs": {"image": ["3", 0], "upscale_method": "lanczos", "width": 1536, "height": 2048, "crop": "disabled"}},
  "5": {"class_type": "UNETLoader", "_meta": {"title": "UNet"},
        "inputs": {"unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default"}},
  "6": {"class_type": "CLIPLoader", "_meta": {"title": "TextEncoder"},
        "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default"}},
  "7": {"class_type": "VAELoader", "_meta": {"title": "VAE"}, "inputs": {"vae_name": "ae.safetensors"}},
  "8": {"class_type": "ModelSamplingAuraFlow", "_meta": {"title": "ModelSampling"},
        "inputs": {"model": ["5", 0], "shift": 3.0}},
  "9": {"class_type": "CLIPTextEncode", "_meta": {"title": "Positive"}, "inputs": {"clip": ["6", 0], "text": ""}},
  "10": {"class_type": "CLIPTextEncode", "_meta": {"title": "Negative"}, "inputs": {"clip": ["6", 0], "text": ""}},
  "11": {"class_type": "VAEEncodeTiled", "_meta": {"title": "Encode"},
         "inputs": {"pixels": ["4", 0], "vae": ["7", 0], "tile_size": 1024, "overlap": 64,
                    "temporal_size": 64, "temporal_overlap": 8}},
  "12": {"class_type": "KSampler", "_meta": {"title": "Sampler"},
         "inputs": {"model": ["8", 0], "positive": ["9", 0], "negative": ["10", 0], "latent_image": ["11", 0],
                    "seed": 0, "steps": 8, "cfg": 1.0, "sampler_name": "dpmpp_2m_sde", "scheduler": "simple",
                    "denoise": 0.33}},
  "13": {"class_type": "VAEDecodeTiled", "_meta": {"title": "Decode"},
         "inputs": {"samples": ["12", 0], "vae": ["7", 0], "tile_size": 1024, "overlap": 64,
                    "temporal_size": 64, "temporal_overlap": 8}},
  "14": {"class_type": "SaveImage", "_meta": {"title": "Save"},
         "inputs": {"images": ["13", 0], "filename_prefix": "mixai/upscale"}}
}
