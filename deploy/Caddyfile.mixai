# Replace SERVER_IP with your server address before pasting.
# Mix AI Cinema Studio on its own HTTPS port.
# The app has its own login, so no basic_auth here. Paste into /etc/caddy/Caddyfile.
SERVER_IP:8443 {
	# text only: video, audio and images are already compressed, and encoding them costs CPU and breaks ranges
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy 127.0.0.1:8090 {
		# SSE: stream events immediately instead of buffering
		flush_interval -1
	}
}
