{
  "name": "flux2_klein9b_t2i",
  "family": "flux.2-klein-9b",
  "description": "FLUX.2 [klein] 9B distilled text-to-image: the flux2_klein_t2i graph with the 9B fp8 weights and the Qwen3 8B fp8mixed encoder (as in the Comfy-Org 9B templates); 4 steps, cfg 1, zeroed negative. Reuses the installed flux2-vae. FLUX Non-Commercial Licence.",
  "inputs": {
    "prompt": {"type": "str", "required": true, "targets": [["Positive", "text"]]},
    "width":  {"type": "int", "default": 1024, "multiple_of": 16, "targets": [["Latent", "width"], ["Scheduler", "width"]]},
    "height": {"type": "int", "default": 1024, "multiple_of": 16, "targets": [["Latent", "height"], ["Scheduler", "height"]]},
    "seed":   {"type": "int", "default": 0, "targets": [["Noise", "noise_seed"]]},
    "steps":  {"type": "int", "default": 4, "targets": [["Scheduler", "steps"]]},
    "filename_prefix": {"type": "str", "default": "mixai/flux2klein9b", "targets": [["Save", "filename_prefix"]]}
  },
  "outputs": {"image": {"node": "Save", "kind": "image"}},
  "models": {
    "diffusion_models": ["flux-2-klein-9b-fp8.safetensors"],
    "text_encoders": ["qwen_3_8b_fp8mixed.safetensors"],
    "vae": ["flux2-vae.safetensors"]
  },
  "requires": {
    "pack": "ComfyUI core",
    "nodes": ["UNETLoader", "CLIPLoader", "EmptyFlux2LatentImage", "Flux2Scheduler", "CFGGuider", "SamplerCustomAdvanced"],
    "assumed": "Comfy-Org has no 9B text-to-image template (only 9B edit); the 4B t2i graph with 9B files. The 9B templates load FLUX.2-small-decoder's VAE; we keep flux2-vae from the 4B install"
  },
  "lora": {"after": "UNet"},
  "progress_weights": {"Sampler": 4, "UNet": 3, "TextEncoder": 2}
}
