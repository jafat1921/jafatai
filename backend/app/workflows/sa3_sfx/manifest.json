{
  "name": "sa3_sfx",
  "family": "stable-audio-3",
  "description": "Stable Audio 3 Small SFX: sound effects, one-shots and ambience up to 2 minutes. Same graph as sa3_music.",
  "inputs": {
    "prompt": {
      "type": "str",
      "required": true,
      "targets": [
        [
          "Positive",
          "text"
        ]
      ]
    },
    "negative": {
      "type": "str",
      "default": "",
      "targets": [
        [
          "Negative",
          "text"
        ]
      ]
    },
    "seed": {
      "type": "int",
      "default": 0,
      "targets": [
        [
          "Sampler",
          "seed"
        ]
      ]
    },
    "duration_s": {
      "type": "float",
      "default": 30.0,
      "targets": [
        [
          "Latent",
          "seconds"
        ]
      ]
    },
    "steps": {
      "type": "int",
      "default": 8,
      "targets": [
        [
          "Sampler",
          "steps"
        ]
      ]
    },
    "filename_prefix": {
      "type": "str",
      "default": "mixai/sa3",
      "targets": [
        [
          "Save",
          "filename_prefix"
        ]
      ]
    }
  },
  "outputs": {
    "audio": {
      "node": "Save",
      "kind": "audio"
    }
  },
  "models": {
    "checkpoints": [
      "stable_audio_3_small_sfx.safetensors"
    ],
    "text_encoders": [
      "t5gemma_b_b_ul2.safetensors"
    ]
  },
  "progress_weights": {
    "Sampler": 6,
    "Checkpoint": 2,
    "TextEncoder": 1,
    "Decode": 2
  }
}
