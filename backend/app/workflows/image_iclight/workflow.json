{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "Checkpoint"},
        "inputs": {"ckpt_name": "Realistic_Vision_V5.1_fp16-no-ema.safetensors"}},
  "2": {"class_type": "LoadAndApplyICLightUnet", "_meta": {"title": "ICLight"},
        "inputs": {"model": ["1", 0], "model_path": "iclight_sd15_fc.safetensors"}},
  "3": {"class_type": "LoadImage", "_meta": {"title": "Source"}, "inputs": {"image": "example.png"}},
  "4": {"class_type": "ImageScale", "_meta": {"title": "Fit"},
        "inputs": {"image": ["3", 0], "upscale_method": "lanczos", "width": 768, "height": 1024, "crop": "disabled"}},
  "5": {"class_type": "LoadBackgroundRemovalModel", "_meta": {"title": "Matte"},
        "inputs": {"bg_removal_name": "birefnet.safetensors"}},
  "6": {"class_type": "RemoveBackground", "_meta": {"title": "Detect"},
        "inputs": {"bg_removal_model": ["5", 0], "image": ["4", 0]}},
  "7": {"class_type": "EmptyImage", "_meta": {"title": "Grey"},
        "inputs": {"width": 768, "height": 1024, "batch_size": 1, "color": 8355711}},
  "8": {"class_type": "ImageCompositeMasked", "_meta": {"title": "Foreground"},
        "inputs": {"destination": ["7", 0], "source": ["4", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["6", 0]}},
  "9": {"class_type": "VAEEncode", "_meta": {"title": "FgLatent"}, "inputs": {"pixels": ["8", 0], "vae": ["1", 2]}},
  "10": {"class_type": "LoadImage", "_meta": {"title": "Background"}, "inputs": {"image": "background.png"}},
  "11": {"class_type": "ImageScale", "_meta": {"title": "BgFit"},
         "inputs": {"image": ["10", 0], "upscale_method": "lanczos", "width": 768, "height": 1024, "crop": "center"}},
  "12": {"class_type": "VAEEncode", "_meta": {"title": "BgLatent"}, "inputs": {"pixels": ["11", 0], "vae": ["1", 2]}},
  "13": {"class_type": "CLIPTextEncode", "_meta": {"title": "Positive"},
         "inputs": {"text": "best quality, natural lighting", "clip": ["1", 1]}},
  "14": {"class_type": "CLIPTextEncode", "_meta": {"title": "Negative"},
         "inputs": {"text": "lowres, bad anatomy, bad hands, cropped, worst quality", "clip": ["1", 1]}},
  "15": {"class_type": "ICLightConditioning", "_meta": {"title": "Condition"},
         "inputs": {"positive": ["13", 0], "negative": ["14", 0], "vae": ["1", 2], "foreground": ["9", 0],
                    "multiplier": 0.182, "opt_background": ["12", 0]}},
  "16": {"class_type": "LightSource", "_meta": {"title": "Light"},
         "inputs": {"light_position": "Left Light", "multiplier": 1.0, "start_color": "#FFFFFF", "end_color": "#000000",
                    "width": 768, "height": 1024}},
  "17": {"class_type": "VAEEncode", "_meta": {"title": "LightLatent"}, "inputs": {"pixels": ["16", 0], "vae": ["1", 2]}},
  "18": {"class_type": "KSampler", "_meta": {"title": "Sampler"},
         "inputs": {"model": ["2", 0], "positive": ["15", 0], "negative": ["15", 1], "latent_image": ["17", 0],
                    "seed": 0, "steps": 25, "cfg": 2.0, "sampler_name": "dpmpp_2m_sde", "scheduler": "karras",
                    "denoise": 0.9}},
  "19": {"class_type": "VAEDecode", "_meta": {"title": "Decode"}, "inputs": {"samples": ["18", 0], "vae": ["1", 2]}},
  "20": {"class_type": "SaveImage", "_meta": {"title": "Save"}, "inputs": {"images": ["19", 0], "filename_prefix": "mixai/tool"}}
}
