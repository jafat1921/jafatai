# One worker per job lane: mixai-worker@image-audio, mixai-worker@video-audio, mixai-worker@general.
# The instance name is the lane list, dash-separated. Both GPU workers take audio jobs (whichever is
# idle) and render them on their own GPU. Which GPU a lane
# renders on comes from COMFY_IMAGE_URLS / COMFY_VIDEO_URLS in .env, not from this file.
[Unit]
Description=Mix AI Cinema Studio worker (%i lane)
After=network.target mixai-api.service
# the all-lanes worker and the lane workers are either/or
Conflicts=mixai-worker.service

[Service]
Type=simple
User=gpu
WorkingDirectory=/data/apps/mixaicinemastudio/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/apps/mixaicinemastudio/backend/.venv/bin/python -m app.worker --lanes %i
SyslogIdentifier=mixai-worker-%i
# long renders: give an in-flight job time to checkpoint before systemd kills it
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
