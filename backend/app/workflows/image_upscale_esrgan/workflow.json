        "inputs": {"model_name": "RealESRGAN_x4plus.safetensors"}},
  "3": {"class_type": "ImageUpscaleWithModel", "_meta": {"title": "Upscale"},
        "inputs": {"upscale_model": ["2", 0], "image": ["1", 0]}},
