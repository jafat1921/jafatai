{
  "name": "krea2_raw_t2i",
  "family": "krea-2",
  "description": "Krea 2 Raw (undistilled base) text-to-image: the Turbo graph with a real negative prompt, 52 steps and cfg 3.5 (krea-ai/krea-2 README sampling defaults for oss_raw). Same encoder and VAE as Turbo; the Raw weights are a separate 13 GB file.",
  "inputs": {
    "prompt":   {"type": "str", "required": true, "targets": [["Positive", "text"]]},
    "negative": {"type": "str", "default": "", "targets": [["Negative", "text"]]},
    "width":    {"type": "int", "default": 1024, "multiple_of": 16, "targets": [["Latent", "width"]]},
    "height":   {"type": "int", "default": 1024, "multiple_of": 16, "targets": [["Latent", "height"]]},
    "seed":     {"type": "int", "default": 0, "targets": [["Sampler", "seed"]]},
    "steps":    {"type": "int", "default": 52, "targets": [["Sampler", "steps"]]},
    "cfg":      {"type": "float", "default": 3.5, "targets": [["Sampler", "cfg"]]},
    "filename_prefix": {"type": "str", "default": "mixai/krea2raw", "targets": [["Save", "filename_prefix"]]}
  },
  "outputs": {"image": {"node": "Save", "kind": "image"}},
  "models": {
    "diffusion_models": ["krea2_raw_fp8_scaled.safetensors"],
    "text_encoders": ["qwen3vl_4b_fp8_scaled.safetensors"],
    "vae": ["qwen_image_vae.safetensors"]
  },
  "requires": {
    "pack": "ComfyUI core 0.38 (CLIPLoader type krea2)",
    "nodes": ["UNETLoader", "CLIPLoader", "EmptyLatentImage", "KSampler"],
    "assumed": "no official ComfyUI Raw template exists; euler/simple carried over from the Turbo template and steps/cfg from the Krea README; check on the server"
  },
  "lora": {"after": "UNet"},
  "progress_weights": {"Sampler": 12, "UNet": 3, "TextEncoder": 2}
}
