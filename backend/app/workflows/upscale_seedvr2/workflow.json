{
  "1": {"class_type": "VHS_LoadVideo", "_meta": {"title": "Source"},
        "inputs": {"video": "example.mp4", "force_rate": 0, "custom_width": 0, "custom_height": 0,
                   "frame_load_cap": 0, "skip_first_frames": 0, "select_every_nth": 1, "format": "None"}},
  "2": {"class_type": "ImageScale", "_meta": {"title": "Resize"},
        "inputs": {"image": ["1", 0], "upscale_method": "lanczos", "width": 1536, "height": 896, "crop": "disabled"}},
  "3": {"class_type": "SeedVR2Preprocess", "_meta": {"title": "Pre"}, "inputs": {"resized_images": ["2", 0]}},
  "4": {"class_type": "VAELoader", "_meta": {"title": "VAE"}, "inputs": {"vae_name": "seedvr2_ema_vae_fp16.safetensors"}},
  "5": {"class_type": "UNETLoader", "_meta": {"title": "Model"},
        "inputs": {"unet_name": "seedvr2_3b_int8_convrot.safetensors", "weight_dtype": "default"}},
  "6": {"class_type": "VAEEncodeTiled", "_meta": {"title": "Encode"},
        "inputs": {"pixels": ["3", 0], "vae": ["4", 0], "tile_size": 512, "overlap": 128,
                   "temporal_size": 64, "temporal_overlap": 8}},
  "7": {"class_type": "SeedVR2TemporalChunk", "_meta": {"title": "Split"},
        "inputs": {"latent": ["6", 0], "temporal_overlap": 2, "chunking_mode": "auto"}},
  "8": {"class_type": "SeedVR2Conditioning", "_meta": {"title": "Cond"},
        "inputs": {"model": ["5", 0], "vae_conditioning": ["7", 0]}},
  "9": {"class_type": "KSampler", "_meta": {"title": "Sampler"},
        "inputs": {"model": ["5", 0], "positive": ["8", 0], "negative": ["8", 1], "latent_image": ["7", 0],
                   "seed": 0, "steps": 1, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "10": {"class_type": "SeedVR2TemporalMerge", "_meta": {"title": "Merge"},
         "inputs": {"latents": ["9", 0], "temporal_overlap": ["7", 1]}},
  "11": {"class_type": "VAEDecodeTiled", "_meta": {"title": "Decode"},
         "inputs": {"samples": ["10", 0], "vae": ["4", 0], "tile_size": 512, "overlap": 128,
                    "temporal_size": 64, "temporal_overlap": 8}},
  "12": {"class_type": "SeedVR2PostProcessing", "_meta": {"title": "Post"},
         "inputs": {"images": ["11", 0], "original_resized_images": ["2", 0], "color_correction_method": "lab"}},
  "13": {"class_type": "VHS_VideoCombine", "_meta": {"title": "Save"},
         "inputs": {"images": ["12", 0], "frame_rate": 24.0, "loop_count": 0, "filename_prefix": "mixai/upscale",
                    "format": "video/h264-mp4", "pingpong": false, "save_output": true, "pix_fmt": "yuv420p",
                    "crf": 12, "save_metadata": false, "trim_to_audio": false}}
}
