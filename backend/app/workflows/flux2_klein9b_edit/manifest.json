{
  "name": "flux2_klein9b_edit",
  "family": "flux.2-klein-9b",
  "description": "FLUX.2 [klein] 9B distilled reference edit (Comfy-Org 'Flux.2 [Klein] 9B Distilled: Image Edit'): each reference VAE-encoded and chained through ReferenceLatent on the prompt and on its zeroed negative, 4 steps, cfg 1. Same distilled file as the 9B text-to-image, so no extra download. 1-3 references. FLUX Non-Commercial Licence.",
  "inputs": {
    "prompt":   {"type": "str", "required": true, "targets": [["Positive", "text"]]},
    "images":   {"type": "image_list", "required": true, "min": 1,
                 "slots": [["Ref1", "image"], ["Ref2", "image"], ["Ref3", "image"]],
                 "drop_unused": [["Ref2", "Ref2Scale", "Ref2Latent", "PosRef2", "NegRef2"],
                                 ["Ref3", "Ref3Scale", "Ref3Latent", "PosRef3", "NegRef3"]],
                 "bypass_unused": {"PosRef2": {"0": "conditioning"}, "NegRef2": {"0": "conditioning"},
                                   "PosRef3": {"0": "conditioning"}, "NegRef3": {"0": "conditioning"}}},
    "width":    {"type": "int", "default": 1024, "multiple_of": 16, "targets": [["Latent", "width"], ["Scheduler", "width"]]},
    "height":   {"type": "int", "default": 1024, "multiple_of": 16, "targets": [["Latent", "height"], ["Scheduler", "height"]]},
    "seed":     {"type": "int", "default": 0, "targets": [["Noise", "noise_seed"]]},
    "steps":    {"type": "int", "default": 4, "targets": [["Scheduler", "steps"]]},
    "filename_prefix": {"type": "str", "default": "mixai/flux2edit9b", "targets": [["Save", "filename_prefix"]]}
  },
  "outputs": {"image": {"node": "Save", "kind": "image"}},
  "models": {
    "diffusion_models": ["flux-2-klein-9b-fp8.safetensors"],
    "text_encoders": ["qwen_3_8b_fp8mixed.safetensors"],
    "vae": ["flux2-vae.safetensors"]
  },
  "requires": {
    "pack": "ComfyUI core",
    "nodes": ["ReferenceLatent", "ImageScaleToTotalPixels", "Flux2Scheduler", "CFGGuider", "SamplerCustomAdvanced"],
    "assumed": "the template sizes the canvas from the first reference (GetImageSize); the app passes its own size, as the 4B edit does"
  },
  "lora": {"after": "UNet"},
  "progress_weights": {"Sampler": 4, "UNet": 3, "TextEncoder": 2}
}
